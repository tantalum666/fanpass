PORT=4000
FANPASS_ENV=local
FANPASS_DATA_SOURCE=prisma
FANPASS_ENABLE_PRISMA_CONNECT=true
QR_SIGNING_SECRET=replace-with-local-dev-secret
SESSION_SIGNING_SECRET=replace-with-local-session-secret
FANPASS_ONSALE_QUEUE_SECRET=replace-with-local-onsale-queue-secret
SESSION_TTL_SECONDS=28800
QR_TTL_SECONDS=30
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
FANPASS_CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173,http://localhost:5174,http://localhost:5175
FANPASS_ENABLE_DEMO_AUTH=true
RATE_LIMIT_GENERAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PRIVY_PER_MINUTE=12
RATE_LIMIT_PRIVY_ORIGIN_PER_MINUTE=300
RATE_LIMIT_VERIFY_PER_MINUTE=120
DATABASE_URL=postgresql://fanpass:fanpass@localhost:5432/fanpass
REDIS_URL=redis://localhost:6379
FANPASS_ENABLE_PAYMENTS=true
FANPASS_REQUIRE_PAYMENT_AUTHORIZATION=true
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FANPASS_STRIPE_CAPTURE_TIMEOUT_MS=10000
FANPASS_STRIPE_CAPTURE_TX_TIMEOUT_MS=20000
OWNERSHIP_ADAPTER=mock
FANPASS_ALLOW_PRIVATE_KEY_TESTNET_WRITES=false
FANPASS_CHAIN_PROOF_SYNC_OUTBOX=false
TESTNET_RPC_URL=
TESTNET_OPERATOR_PRIVATE_KEY=replace-with-non-production-testnet-operator-private-key
FANPASS_TICKET_CONTRACT_ADDRESS=
