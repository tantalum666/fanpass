generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FAN
  ORGANIZER
  GATE_STAFF
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum TicketStatus {
  CREATED
  ACTIVE
  LISTED_FOR_RESALE
  TRANSFER_PENDING
  TRANSFERRED
  REDEEMED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  MATCHED
  SETTLED
  CANCELLED
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String?
  role            UserRole         @default(FAN)
  privyId         String?          @unique @map("privy_id")
  walletAddress   String?          @map("wallet_address")
  riskScore       Float            @default(0) @map("risk_score")
  kycStatus       String           @default("NOT_REQUIRED") @map("kyc_status")
  createdAt       DateTime         @default(now()) @map("created_at")
  tickets         Ticket[]         @relation("TicketOwner")
  orders          Order[]
  payments        Payment[]
  checkins        Checkin[]        @relation("ScannerCheckins")
  gateAssignments GateAssignment[] @relation("GateStaffAssignments")

  @@map("users")
}

model Organizer {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  organizationName   String  @map("organization_name")
  verificationStatus String  @default("PENDING") @map("verification_status")
  payoutAccountId    String? @map("payout_account_id")
  events             Event[]

  @@map("organizers")
}

model Venue {
  id       String  @id @default(cuid())
  name     String
  country  String
  city     String
  address  String
  timezone String
  capacity Int
  events   Event[]

  @@map("venues")
}

model Event {
  id              String           @id @default(cuid())
  organizerId     String           @map("organizer_id")
  venueId         String           @map("venue_id")
  title           String
  startTime       DateTime         @map("start_time")
  endTime         DateTime         @map("end_time")
  status          EventStatus      @default(DRAFT)
  policyId        String?          @map("policy_id")
  posterUrl       String?          @map("poster_url")
  organizer       Organizer        @relation(fields: [organizerId], references: [id])
  venue           Venue            @relation(fields: [venueId], references: [id])
  ticketTypes     TicketType[]
  tickets         Ticket[]
  fanTasks        FanTask[]
  orders          Order[]
  gateAssignments GateAssignment[]

  @@map("events")
}

model GateAssignment {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  gate        String
  staffUserId String   @map("staff_user_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  event       Event    @relation(fields: [eventId], references: [id])
  staff       User     @relation("GateStaffAssignments", fields: [staffUserId], references: [id])

  @@unique([eventId, gate, staffUserId])
  @@map("gate_assignments")
}

model StaffInvite {
  id               String    @id @default(cuid())
  eventId          String    @map("event_id")
  gateAssignmentId String    @map("gate_assignment_id")
  staffUserId      String    @map("staff_user_id")
  email            String
  tokenHash        String    @unique @map("token_hash")
  status           String    @default("PENDING")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedPrivyId  String?   @map("accepted_privy_id")
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([eventId, gateAssignmentId, status])
  @@index([staffUserId, status])
  @@map("staff_invites")
}

model TicketType {
  id               String   @id @default(cuid())
  eventId          String   @map("event_id")
  name             String
  faceValue        Int      @map("face_value")
  currency         String
  supply           Int
  transferable     Boolean  @default(true)
  resaleCap        Int?     @map("resale_cap")
  maxTransferCount Int      @default(1) @map("max_transfer_count")
  event            Event    @relation(fields: [eventId], references: [id])
  tickets          Ticket[]
  orders           Order[]

  @@map("ticket_types")
}

model Ticket {
  id               String            @id @default(cuid())
  tokenId          String?           @map("token_id")
  eventId          String            @map("event_id")
  ticketTypeId     String            @map("ticket_type_id")
  ownerId          String            @map("owner_id")
  seatHash         String?           @map("seat_hash")
  status           TicketStatus      @default(CREATED)
  transferCount    Int               @default(0) @map("transfer_count")
  metadataUri      String?           @map("metadata_uri")
  event            Event             @relation(fields: [eventId], references: [id])
  ticketType       TicketType        @relation(fields: [ticketTypeId], references: [id])
  owner            User              @relation("TicketOwner", fields: [ownerId], references: [id])
  trades           Trade[]
  checkins         Checkin[]
  orders           Order[]
  entryCredentials EntryCredential[]

  @@map("tickets")
}

model Order {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  eventId           String      @map("event_id")
  ticketTypeId      String      @map("ticket_type_id")
  ticketId          String?     @map("ticket_id")
  side              OrderSide
  price             Int
  quantity          Int         @default(1)
  remainingQuantity Int         @default(1) @map("remaining_quantity")
  status            OrderStatus @default(OPEN)
  idempotencyKey    String?     @map("idempotency_key")
  createdAt         DateTime    @default(now()) @map("created_at")
  user              User        @relation(fields: [userId], references: [id])
  event             Event       @relation(fields: [eventId], references: [id])
  ticketType        TicketType  @relation(fields: [ticketTypeId], references: [id])
  ticket            Ticket?     @relation(fields: [ticketId], references: [id])
  buyTrade          Trade?      @relation("BuyOrder")
  sellTrade         Trade?      @relation("SellOrder")
  payments          Payment[]

  @@unique([userId, idempotencyKey])
  @@map("orders")
}

model Trade {
  id               String   @id @default(cuid())
  buyOrderId       String   @unique @map("buy_order_id")
  sellOrderId      String   @unique @map("sell_order_id")
  ticketId         String   @map("ticket_id")
  price            Int
  fee              Int
  settlementStatus String   @map("settlement_status")
  createdAt        DateTime @default(now()) @map("created_at")
  buyOrder         Order    @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder        Order    @relation("SellOrder", fields: [sellOrderId], references: [id])
  ticket           Ticket   @relation(fields: [ticketId], references: [id])

  @@map("trades")
}

model FanTask {
  id                 String              @id @default(cuid())
  eventId            String              @map("event_id")
  title              String
  taskType           String              @map("task_type")
  points             Int
  verificationMethod String              @map("verification_method")
  startTime          DateTime?           @map("start_time")
  endTime            DateTime?           @map("end_time")
  event              Event               @relation(fields: [eventId], references: [id])
  submissions        FanTaskSubmission[]

  @@map("fan_tasks")
}

model FanTaskSubmission {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  taskId     String           @map("task_id")
  proof      String
  status     SubmissionStatus @default(PENDING)
  reviewedBy String?          @map("reviewed_by")
  reviewedAt DateTime?        @map("reviewed_at")
  task       FanTask          @relation(fields: [taskId], references: [id])

  @@map("fan_task_submissions")
}

model FanScore {
  id                String @id @default(cuid())
  userId            String @map("user_id")
  eventId           String @map("event_id")
  score             Int
  rank              Int?
  entitlementStatus String @map("entitlement_status")

  @@unique([userId, eventId])
  @@map("fan_scores")
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  orderId               String?  @map("order_id")
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  clientSecret          String?  @map("client_secret")
  amount                Int
  currency              String
  status                String
  captureStatus         String   @map("capture_status")
  idempotencyKey        String?  @map("idempotency_key")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id])
  order                 Order?   @relation(fields: [orderId], references: [id])

  @@unique([userId, idempotencyKey])
  @@map("payments")
}

model PaymentWebhookEvent {
  id                    String    @id @default(cuid())
  stripeEventId         String    @unique @map("stripe_event_id")
  type                  String
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  paymentId             String?   @map("payment_id")
  status                String
  reason                String?
  payloadJson           Json?     @map("payload_json")
  processedAt           DateTime? @map("processed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Checkin {
  id               String   @id @default(cuid())
  ticketId         String   @map("ticket_id")
  scannerUserId    String   @map("scanner_user_id")
  gate             String
  nonce            String
  acceptedNonce    String?  @unique @map("accepted_nonce")
  acceptedTicketId String?  @unique @map("accepted_ticket_id")
  result           String
  checkedInAt      DateTime @default(now()) @map("checked_in_at")
  ticket           Ticket   @relation(fields: [ticketId], references: [id])
  scanner          User     @relation("ScannerCheckins", fields: [scannerUserId], references: [id])

  @@map("checkins")
}

model EntryCredential {
  id                       String    @id
  ticketId                 String    @map("ticket_id")
  eventId                  String    @map("event_id")
  ticketTypeId             String?   @map("ticket_type_id")
  ownerIdHash              String    @map("owner_id_hash")
  nonce                    String    @unique
  entryMode                String    @map("entry_mode")
  keyId                    String?   @map("key_id")
  status                   String    @default("ACTIVE")
  revokedReason            String?   @map("revoked_reason")
  supersededByCredentialId String?   @map("superseded_by_credential_id")
  issuedAt                 DateTime  @map("issued_at")
  expiresAt                DateTime  @map("expires_at")
  consumedAt               DateTime? @map("consumed_at")
  consumedCheckinId        String?   @map("consumed_checkin_id")
  scannerUserId            String?   @map("scanner_user_id")
  gate                     String?
  createdByUserId          String?   @map("created_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  ticket                   Ticket    @relation(fields: [ticketId], references: [id])

  @@index([ticketId, status, expiresAt])
  @@index([eventId, status])
  @@map("entry_credentials")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String   @map("actor_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  metadataJson Json     @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model SideEffectOutbox {
  id             String    @id @default(cuid())
  type           String
  status         String    @default("PENDING")
  idempotencyKey String    @unique @map("idempotency_key")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  payloadJson    Json      @map("payload_json")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  availableAt    DateTime  @default(now()) @map("available_at")
  lockedAt       DateTime? @map("locked_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("side_effect_outbox")
}
