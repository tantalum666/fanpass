{
  "name": "@fanpass/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "rm -rf dist && prisma generate",
    "dev": "nest start --watch",
    "prebuild": "rm -rf dist && prisma generate",
    "pretypecheck": "rm -f dist/tsconfig.tsbuildinfo && prisma generate",
    "start": "node dist/src/main.js",
    "build": "nest build",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "alpha:seed": "ts-node prisma/seed-alpha.ts",
    "public-events:upsert": "node dist/src/workers/upsert-public-events.js",
    "side-effects:work-once": "ts-node src/workers/side-effect-worker-once.ts",
    "side-effects:health": "ts-node src/workers/side-effect-health-check.ts",
    "chain:sepolia-dev:ownership-smoke": "ts-node src/workers/sepolia-dev-ownership-smoke.ts",
    "chain:sepolia-dev:outbox-smoke": "ts-node src/workers/sepolia-dev-outbox-proof-sync-smoke.ts"
  },
  "dependencies": {
    "@fanpass/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "^6.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.19",
    "jest": "^29.7.0",
    "prisma": "^6.8.2",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
