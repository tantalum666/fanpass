// Copy this file to LocalSecrets.xcconfig for local/dev builds.
// LocalSecrets.xcconfig is gitignored. Keep real values out of source control.
// Do not put private keys, bearer tokens, webhook secrets, database URLs, or Privy verification keys here.
//
// In xcconfig files, write URLs as https:/$()/host/path so // is not parsed as a comment.

FANPASS_API_BASE_URL = https:/$()/fanpass-api-staging.onrender.com
FANPASS_PRIVY_APP_ID = <public Privy app id>
FANPASS_PRIVY_APP_CLIENT_ID = <public Privy app client id>
FANPASS_STRIPE_PUBLISHABLE_KEY = pk_test_<publishable key>
