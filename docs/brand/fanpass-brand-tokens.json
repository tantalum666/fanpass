      "borderDefault": { "value": "#23314A", "type": "color" },
      "borderFocus": { "value": "#46E8FF", "type": "color" }
    }
  },
  "gradients": {
    "brand": {
      "type": "linear-gradient",
      "angle": 135,
      "stops": [
        { "color": "#46E8FF", "position": 0 },
        { "color": "#7C3AED", "position": 45 },
        { "color": "#F43FDA", "position": 100 }
      ]
    },
    "background": {
      "type": "radial-gradient",
      "shape": "circle",
      "position": "18% 8%",
      "stops": [
        { "color": "#2E1065", "position": 0 },
        { "color": "#07152A", "position": 48 },
        { "color": "#020617", "position": 100 }
      ]
    },
    "scanPulse": {
      "type": "linear-gradient",
      "angle": 90,
      "stops": [
        { "color": "#46E8FF", "position": 0 },
        { "color": "#22C55E", "position": 100 }
      ]
    }
  },
  "typography": {
    "fontFamilies": {
      "ui": "-apple-system, BlinkMacSystemFont, SF Pro Text, system-ui, sans-serif",
      "display": "SF Pro Display, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
      "mono": "SF Mono, ui-monospace, Menlo, monospace"
    },
    "scale": {
      "display": { "fontSize": 40, "lineHeight": 46, "fontWeight": 600 },
      "largeTitle": { "fontSize": 34, "lineHeight": 40, "fontWeight": 600 },
      "title1": { "fontSize": 28, "lineHeight": 34, "fontWeight": 600 },
      "title2": { "fontSize": 24, "lineHeight": 30, "fontWeight": 600 },
