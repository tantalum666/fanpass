  "radius": {
    "xs": { "value": 6, "type": "dimension" },
    "sm": { "value": 8, "type": "dimension" },
    "md": { "value": 12, "type": "dimension" },
    "lg": { "value": 16, "type": "dimension" },
    "xl": { "value": 24, "type": "dimension" },
    "2xl": { "value": 32, "type": "dimension" }
  },
  "shadows": {
    "none": { "shadows": [] },
    "card": { "shadows": [{ "x": 0, "y": 10, "blur": 30, "spread": 0, "color": "#00000033" }] },
    "ticket": { "shadows": [{ "x": 0, "y": 24, "blur": 70, "spread": 0, "color": "#00000066" }] },
    "signal": { "shadows": [{ "x": 0, "y": 0, "blur": 24, "spread": 0, "color": "#46E8FF26" }] }
  },
  "chartColors": {
    "primary": "#46E8FF",
    "secondary": "#7C3AED",
    "highlight": "#F43FDA",
    "success": "#22C55E",
    "warning": "#F59E0B",
    "danger": "#EF4444",
    "grid": "#23314A",
    "label": "#AAB4C5"
  },
  "ticketStatusColors": {
    "verifiedTicket": { "background": "#063746", "foreground": "#46E8FF", "border": "#46E8FF" },
    "nfcReady": { "background": "#2A135E", "foreground": "#D8C8FF", "border": "#7C3AED" },
    "secureResale": { "background": "#09351D", "foreground": "#22C55E", "border": "#22C55E" },
    "proofHistory": { "background": "#020617", "foreground": "#F8FAFC", "border": "#23314A" },
    "pending": { "background": "#3A2608", "foreground": "#F59E0B", "border": "#F59E0B" },
    "rejected": { "background": "#3B0B0B", "foreground": "#EF4444", "border": "#EF4444" },
    "redeemed": { "background": "#172033", "foreground": "#AAB4C5", "border": "#23314A" }
  },
  "usageRules": [
    "Do not redesign the FanPass logo or app icon.",
    "Do not add decorative diagonal curves behind logo, brand sheet, ticket cards, text, QR codes, charts, buttons, or prices.",
    "Keep NFC/proof waves inside dedicated UI components only.",
    "Do not let chart lines or proof graphics cross over text.",
    "Use logo mark without extra visual metaphors for app icon and navigation."
  ]
